# ccreward-cn Backend Environment Variables

DEBUG=false

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/ccreward.db
# DATABASE_URL=postgresql+asyncpg://ccreward:yourpassword@localhost:5432/ccreward

CRAWLER_ENABLED=true
CRAWLER_INTERVAL_HOURS=6

JWT_SECRET=change-me-in-production-32-chars+

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENABLED=false

FIREBASE_PROJECT_ID=
FIREBASE_ENABLED=false

PUSHPLUS_TOKEN=
PUSHPLUS_ENABLED=false

SERVERCHAN_KEY=
SERVERCHAN_ENABLED=false

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_ENABLED=false

NOTIFY_HOUR=9
NOTIFY_MINUTE=0
